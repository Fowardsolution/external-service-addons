<odoo>
    <data noupdate="1">
        <record id="ir_cron_my_cron_job" model="ir.cron">
            <field name="name">Actualizar Tasa de Moneda</field>
            <field name="model_id" ref="model_res_currency_update"/>
            <field name="state">code</field>
            <field name="code">model.update_currency_rate()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="user_id">2</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(hours=8)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <!-- <field name="nextcall" eval="(context_today() + timedelta(hours=8)).strftime('%Y-%m-%d %H:%M:%S')"/> -->
        </record>
    </data>
</odoo>
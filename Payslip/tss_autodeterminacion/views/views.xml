<odoo>
    <data>
        <record id="hr_tss_reports_tree_view" model="ir.ui.view">
            <field name="name">Reporte TSS</field>
            <field name="model">hr.tss_report_wizard</field>
            <field name="arch" type="xml">
                <form string="Reporte TSS">
                    <header>
                        <button name="generate_txt" string="Generar Archivo TXT"
                                type="object" class="oe_highlight"/>
                        <button name="generate_excel" string="Exportar Excel"
                                type="object" class="oe_highlight"/>
                    </header>
                    <field name="errors" invisible="1"/>
                    <field name="name" invisible="1"/>
                    <field name="notes" widget="html"/>
                    <group>
                        <group>
                            <field name="rnc" readonly="1"/>
                            <field name="report" filename="report_name" readonly="1"/>
                            <field name="report_name" invisible="1"/>
                        </group>
                        <group>
                            <field name="periodo" readonly="1"/>
                            <field name="proceso" readonly="1"/>
                            <field name="num_lines" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" options="{'create': 0}">
                        <tree editable="bottom">
                            <field name="report_id" invisible="1"/>
                            <field name="clave_nomina" invisible="1"/>
                            <field name="tipo_doc"/>
                            <field name="numero_doc"/>
                            <field name="employee_id"/>
                            <field name="gender"/>
                            <field name="birth_day"/>
                            <field name="salario_cotizable"/>
                            <field name="aporte_voluntario"/>
                            <field name="salario_isr"/>
                            <field name="otro_remuneracion"/>
                            <field name="id_agente"/>
                            <field name="rem_otro_agentes"/>
                            <field name="ing_exentos"/>
                            <field name="saldo_favor"/>
                            <field name="infotep"/>
                            <field name="tipo_ingreso"/>
                        </tree>
                    </field>
                </form>
            </field>
        </record>

        <record id="action_hr_tss_report_server" model="ir.actions.server">
            <field name="name">Generar Reporte TSS</field>
            <field name="model_id" ref="hr_payroll.model_hr_payslip_run"/>
            <field name="binding_model_id" ref="hr_payroll.model_hr_payslip_run"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[
        action = {
            'type': 'ir.actions.act_window',
            'res_model': 'hr.tss_report_wizard',
            'view_mode': 'form',
            'target': 'main',
        }
        ]]></field>
        </record>
    </data>
</odoo>

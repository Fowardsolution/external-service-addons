<odoo>
    <record model="ir.ui.view" id="inherit_hr_salary_rule_form_view">
      <field name="name">RRHH TSS OPTIONS</field>
      <field name="model">hr.salary.rule</field>
      <field name="inherit_id" ref="hr_payroll.hr_salary_rule_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='appears_on_payslip']" position="after">
            <separator colspan="4" string="Reporte Autodeterminacion"/>
            <field name="tss_report"/>
            <field name="tss_columns" widget="many2many_tags"/>
        </xpath>
      </field>
    </record>
</odoo>

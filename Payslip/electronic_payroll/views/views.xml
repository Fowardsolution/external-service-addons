<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- Vista de lista -->
    <record id="electronic_payroll_tree" model="ir.ui.view">
      <field name="name">electronic_payroll.tree</field>
      <field name="model">electronic.payroll</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="effective_date"/>
          <field name="company_id" groups="base.group_multi_company"/>
        </tree>
      </field>
    </record>

    <!-- Vista de formulario -->
    <record id="electronic_payroll_form" model="ir.ui.view">
      <field name="name">electronic_payroll.form</field>
      <field name="model">electronic.payroll</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <button name="set_line_ids" string="Load Lines" type="object" class="oe_highlight"
                invisible="state != 'draft'"/>
            <button name="generate_txt" string="Generate TXT" type="object" class="oe_highlight"
                invisible="state != 'validate'"/>
            <button name="action_validate" string="Validate" type="object" class="oe_highlight"
                invisible="state != 'draft'"/>
            <button name="action_done" string="Mark as Done" type="object" class="oe_highlight"
                invisible="state != 'validate'"/>
            <button name="action_draft" string="Reset to Draft" type="object" class="oe_highlight"
                invisible="state == 'draft'"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,validate,done"/>
          </header>
          <sheet>
            <div class="oe_title">
              <label for="name" class="oe_edit_only"/>
              <h1>
                <field name="name"/>
              </h1>
            </div>
            <group>
              <group>
                <field name="payslip_run_id" domain="[('state','=','close')]"
                    options="{'no_create': True, 'no_quick_create': True, 'no_create_edit':True}"/>
                <field name="binary_name" invisible="1"/>
                <field name="binary" filename="binary_name" invisible="binary == False"/>
              </group>
              <group>
                <field name="effective_date"/>
                <field name="electronic_payroll_type" invisible="1"/>
                <field name="origin_account"
                    invisible="electronic_payroll_type != 'BDR'"
                    required="electronic_payroll_type == 'BDR'"/>
                <label for="total_valid" invisible="line_ids == []"/>
                <div invisible="line_ids == []">
                  <field name="total_valid" class="oe_inline"/> /
                  <field name="total" class="oe_inline"/>
                </div>
                <field name="company_id" groups="base.group_multi_company" readonly="1"/>
              </group>
            </group>
            <notebook>
              <page string="Detail">
                <field name="line_ids">
                  <tree editable="bottom" decoration-muted="no_file==True" decoration-bf="no_file==False">
                    <field name="electronic_id" invisible="1"/>
                    <field name="employee_id"/>
                    <field name="bank_account_id"/>
                    <field name="amount"/>
                    <field name="no_file" widget="boolean_toggle"/>
                  </tree>
                </field>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Acción de ventana -->
    <record id="electronic_payroll_action_window" model="ir.actions.act_window">
      <field name="name">Pago Electrónico</field>
      <field name="res_model">electronic.payroll</field>
      <field name="view_mode">tree,form</field>
      <field name="domain">[]</field>
    </record>

    <!-- Menú -->
    <menuitem name="Pago Electrónico" id="electronic_payroll_menu"
              parent="hr_work_entry_contract_enterprise.menu_hr_payroll_root"
              sequence="65"
              action="electronic_payroll_action_window"/>

  </data>
</odoo>

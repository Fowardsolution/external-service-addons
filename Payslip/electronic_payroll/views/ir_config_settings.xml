<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="res_config_settings_view_form" model="ir.ui.view">
      <field name="name">res.config.settings.view.form</field>
      <field name="model">res.config.settings</field>
      <field name="priority" eval="10"/>
      <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
      <field name="arch" type="xml">

        <!-- Insertamos después del bloque de configuración de nómina -->
        <xpath expr="//block[@id='hr_payroll_settings']" position="after">

          <block title="Electronic Payroll" id="electronic_payroll_settings">

            <setting string="Payroll Type">
              <field name="electronic_payroll_type"/>
              <div class="text-muted">Select the electronic payroll type.</div>
            </setting>

            <setting string="Payroll Email">
              <field name="electronic_payroll_email" invisible="electronic_payroll_type != 'BPD'"/>
              <div class="text-muted">Email to receive the payroll report and file.</div>
            </setting>

            <setting string="Payroll Bank Code">
              <field name="electronic_payroll_bank_code" invisible="electronic_payroll_type != 'BPD'"/>
              <div class="text-muted">5-digit bank code assigned to the company.</div>
            </setting>

            <setting string="Enable Payroll Accounting">
              <field name="module_electronic_payroll_account" widget="upgrade_boolean"/>
              <div class="text-muted">Generate payments or accounting entries for employee payslips.</div>
            </setting>

            <setting string="Enable Batch Payroll Payments">
              <field name="module_electronic_payroll_batch" widget="upgrade_boolean"/>
              <div class="text-muted">Enable batch payments for electronic payroll.</div>
            </setting>

          </block>

        </xpath>

      </field>
    </record>

  </data>
</odoo>

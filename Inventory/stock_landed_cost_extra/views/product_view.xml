<odoo>
  <data>

      <record id="product_template_history_cost" model="ir.ui.view">
          <field name="name">product_template_history_cost</field>
          <field name="model">product.template</field>
          <field name="inherit_id" ref="product.product_template_form_view"/>
          <field name="arch" type="xml">
              <xpath expr="//notebook" position="inside">
                <page string="Historico de Liquidaciones">
                  <field name="cost_history" create="0">
                      <tree create="0" editable="bottom">
                          <field name="cost_id"/>
                          <field name="quantity"/>
                          <field name="former_cost"/>
                          <field name="additional_cost"/>
                          <field name="final_cost"/>
                          <field name="cost_unit"/>
                      </tree>
                  </field>
                </page>
              </xpath>
          </field>
      </record>

  </data>
</odoo>

<odoo>
  <data>

      <record id="view_purchase_form" model="ir.ui.view">
          <field name="name">view_purchase_form</field>
          <field name="model">purchase.order</field>
          <field name="inherit_id" ref="purchase.purchase_order_form"/>
          <field name="arch" type="xml">
              <xpath expr="//field[@name='partner_id']" position="after">
                <field name="cost_id" invisible="1"/>
              </xpath>

              <div name="button_box" class="oe_button_box" position="inside" >
                <button 
                  class="oe_stat_button" 
                  type="object" 
                  name="action_purchase_order" 
                  icon="fa-usd" 
                  modifiers="{'invisible':[('cost_id','=',False)]}">
                  Liquidaciones
                </button>
              </div>

          </field>
      </record>

  </data>
</odoo>
